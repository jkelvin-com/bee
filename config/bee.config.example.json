{
  "version": 2,
  "user_name": "Alex",
  "agent_name": "claude",
  "timezone": "UTC",
  "send": {
    "paragraph_per_message": true,
    "gap_seconds": [
      1,
      2
    ]
  },
  "backend": {
    "type": "drive-vault",
    "drive": {
      "root": "brain",
      "vault_folder": "Vault",
      "inbox_folder_id": "your-0-inbox-folder-id",
      "layout": "oaa2b"
    },
    "github": {
      "owner": "your-github-username",
      "repo": "your-vault-repo",
      "branch": "main",
      "layout": "oaa2b",
      "role": "fallback"
    },
    "local": {
      "folder": "~/Documents/vault",
      "layout": "obsidian-ai"
    },
    "notion": {
      "styles_page": "page id or title",
      "notes_database": "database id or title"
    },
    "notebooklm": {
      "notebook_url": "https://notebooklm.google.com/notebook/NOTEBOOK_ID"
    }
  },
  "layout_oaa2b": {
    "write_dir": "0-inbox",
    "filename": "{slug}-{agent}-{surface}-{YYYY-MM-DD-HHMM}.md",
    "surface": "cowork",
    "frontmatter_first": true,
    "first_body_line": "↑ [[INBOX]]",
    "rules_file": "START-HERE.md",
    "law_file": "9-system/sys-law.md",
    "heartbeat_file": "9-system/state/HEARTBEAT.md",
    "style_notes": [
      "me-talk-preferences",
      "me-writing-voice",
      "me-reply-patterns"
    ],
    "never_edit": true
  },
  "layout_obsidian_ai": {
    "write_dir": "AI/",
    "filename": "{agent}-{YYYY-MM-DD-HHMM}-{slug}.md",
    "first_line": "[[AI]]",
    "base_tags": [
      "ai"
    ],
    "rules_file": "CORE/INSTRUCTIONS.md",
    "heartbeat_file": "CORE/heartbeat.md",
    "style_files": [
      "TOPICS/writing-voice.md",
      "CORE/preferences.md"
    ],
    "learned_style_glob": "AI/*-bee-style-*.md"
  },
  "workings": {
    "root": "brain/Workings",
    "root_folder_id": "your-workings-folder-id",
    "bee_triage_folder_id": "your-bee-triage-folder-id",
    "bee_send_folder_id": "your-bee-send-folder-id",
    "bee_decisions_folder_id": "your-bee-decisions-folder-id",
    "bee_triage_archive_folder_id": "your-bee-triage-archive-folder-id",
    "prefix": "",
    "stamp": "YYYY-MM-DD-HHMM"
  }
}
